#!/usr/bin/env python3
"""sayance-lookup: POSIX Issue 8 reference with Omarchy-aware guidance.

Usage:
    sayance-lookup <utility>       Show syntax and examples
    sayance-lookup --list          List all available utilities
    sayance-lookup --local-tools   List Omarchy tools and portable alternatives
    sayance-lookup --aliases       Backward-compatible alias for --local-tools
    sayance-lookup --json <util>   Output as JSON
    sayance-lookup --version       Print version and exit
"""

LOCAL_TOOLS = {
    "tar": ("pax", "GNU tar is installed and appropriate for local archives."),
    "bsdtar": ("pax", "bsdtar is installed and appropriate for local archives."),
    "gzip": ("compress", "gzip is installed; prefer it locally over legacy LZW compression."),
    "gunzip": ("uncompress", "gunzip is installed; prefer it locally over legacy LZW compression."),
    "xz": (None, "xz is installed; POSIX has no equivalent compression format."),
    "zstd": (None, "zstd is installed; POSIX has no equivalent compression format."),
    "xxd": ("od", "xxd may be used locally when installed; od is the portable dump tool."),
    "hexdump": ("od", "hexdump may be used locally when installed; od is portable."),
    "md5sum": (None, "Coreutils digest tool; POSIX cksum is not a cryptographic substitute."),
    "sha1sum": (None, "Coreutils digest tool; POSIX cksum is not a cryptographic substitute."),
    "sha256sum": (None, "Installed Coreutils digest tool; POSIX cksum is not a cryptographic substitute."),
    "b2sum": (None, "Installed Coreutils BLAKE2 digest tool; POSIX has no equivalent."),
    "tac": ("awk", "GNU tac is available locally; use awk only when portability requires it."),
    "seq": ("awk", "GNU seq is available locally; awk can generate sequences portably."),
    "shuf": (None, "GNU shuf is available locally; POSIX has no direct equivalent."),
    "rev": ("awk", "rev is appropriate locally when installed; awk can reverse text portably."),
    "wget": (None, "wget is appropriate locally when installed; POSIX has no fetch utility."),
    "rg": ("grep", "ripgrep is installed and preferred for local text search."),
    "fd": ("find", "fd is installed and convenient for local file discovery."),
    "bat": ("cat", "bat is installed for interactive viewing; cat is portable."),
    "jq": (None, "jq is installed and preferred for structured JSON processing."),
}

import json
import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent


def resolve_version() -> str:
    """Read version from the VERSION file shipped alongside the script."""
    candidates = [
        _HERE / "VERSION",
        _HERE.parent.parent / "VERSION",
        Path.home() / ".claude" / "skills" / "sayance" / "VERSION",
        Path.home() / ".codex" / "skills" / "sayance" / "VERSION",
    ]
    for candidate in candidates:
        try:
            return candidate.read_text().strip()
        except OSError:
            continue
    return "unknown"


def resolve_data_path() -> Path | None:
    """Locate sayance-tldr.json across installed and development layouts."""
    candidates = [
        _HERE / "sayance-tldr.json",
        _HERE.parent.parent / "skill" / "sayance-tldr.json",
        Path.home() / ".claude" / "skills" / "sayance" / "sayance-tldr.json",
        Path.home() / ".codex" / "skills" / "sayance" / "sayance-tldr.json",
    ]
    for candidate in candidates:
        if candidate.exists():
            return candidate
    return None


def main():
    if len(sys.argv) < 2:
        print("Usage: sayance-lookup <utility>", file=sys.stderr)
        print("       sayance-lookup --list", file=sys.stderr)
        print("       sayance-lookup --local-tools", file=sys.stderr)
        print("       sayance-lookup --aliases", file=sys.stderr)
        print("       sayance-lookup --json <util>", file=sys.stderr)
        print("       sayance-lookup --version", file=sys.stderr)
        sys.exit(1)

    if sys.argv[1] == "--version":
        print(f"sayance {resolve_version()}")
        return

    data_path = resolve_data_path()
    if data_path is None:
        print(
            "Could not locate sayance-tldr.json. Install with 'make install' "
            "or place the file next to this script.",
            file=sys.stderr,
        )
        sys.exit(1)

    try:
        tldr = json.loads(data_path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        print(f"Failed to read {data_path}: {exc}", file=sys.stderr)
        sys.exit(1)

    arg = sys.argv[1].lower()

    if arg == "--list":
        for name in sorted(tldr):
            print(name)
        return

    if arg in ("--local-tools", "--aliases"):
        for local, (portable, note) in sorted(LOCAL_TOOLS.items()):
            suffix = f"; strict POSIX: {portable}" if portable else "; no direct POSIX equivalent"
            print(f"{local}: {note} {suffix.lstrip('; ')}")
        return

    if arg == "--json" and len(sys.argv) > 2:
        util = sys.argv[2].lower()
        if util in LOCAL_TOOLS:
            portable, note = LOCAL_TOOLS[util]
            print(json.dumps({util: {"omarchy": note, "strict_posix": portable}}))
            return
        entry = tldr.get(util)
        if not entry:
            print(json.dumps({"error": f"No entry for '{util}'"}))
            sys.exit(1)
        print(json.dumps({util: entry}))
        return

    if arg in LOCAL_TOOLS:
        portable, note = LOCAL_TOOLS[arg]
        print(f"  Omarchy: {note}")
        if portable:
            print(f"  Strict POSIX alternative: {portable}")
        else:
            print("  Strict POSIX: no direct equivalent; preserve the required semantics explicitly.")
        return

    entry = tldr.get(arg)
    if not entry:
        print(f"No entry for '{arg}'. Run sayance-lookup --list for available utilities.", file=sys.stderr)
        sys.exit(1)

    print(f"  Strict POSIX reference for {arg} (GNU/Linux extensions may also be available):")
    for line in entry:
        print(f"  {line}")


if __name__ == "__main__":
    main()
